<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinForge Engine"
        Width="1140"
        Height="750"
        MinWidth="860"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBase" Color="#121212"/>
        <SolidColorBrush x:Key="BgPanel" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BgCard" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="BorderLine" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#4A4A4A"/>
        <SolidColorBrush x:Key="TextMain" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9A9A9A"/>

        <Style x:Key="MonoPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="Foreground" Value="#121212"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonoSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#323232"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonoOutlineDangerButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#6E6E6E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#353535"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavCategoryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BDBDBD"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#262626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="205"/>
        </Grid.RowDefinitions>

        <!-- Cabecera compacta monocromática -->
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="6" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EDEDED" CornerRadius="4" Width="26" Height="26" Margin="0,0,10,0">
                            <TextBlock Text="WF" FontWeight="Bold" FontSize="12" Foreground="#121212" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="WinForge Engine" FontSize="17" FontWeight="Bold" Foreground="#F2F2F2" VerticalAlignment="Center"/>
                        <TextBlock Text="• Monocromo Ligero (PC Antiguo y Moderno)" FontSize="12" Foreground="#8E8E8E" VerticalAlignment="Center" Margin="8,1,0,0"/>
                    </StackPanel>

                    <WrapPanel Margin="0,8,0,0">
                        <Border Background="#141414" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,2">
                            <TextBlock x:Name="TxtHardwareOS" Text="OS: ..." FontSize="11.5" Foreground="#E0E0E0"/>
                        </Border>
                        <Border Background="#141414" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,2">
                            <TextBlock x:Name="TxtHardwareCPU" Text="CPU: ..." FontSize="11.5" Foreground="#A0A0A0"/>
                        </Border>
                        <Border Background="#141414" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,2">
                            <TextBlock x:Name="TxtHardwareRAM" Text="RAM: ..." FontSize="11.5" Foreground="#A0A0A0"/>
                        </Border>
                        <Border x:Name="BadgeStorage" Background="#141414" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,2">
                            <TextBlock x:Name="TxtHardwareStorage" Text="Disco: ..." FontSize="11.5" Foreground="#E0E0E0"/>
                        </Border>
                        <Border x:Name="BadgeChassis" Background="#141414" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,2">
                            <TextBlock x:Name="TxtHardwareChassis" Text="Equipo: ..." FontSize="11.5" Foreground="#A0A0A0"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnGuidedWizard" Content="Asistente" Style="{StaticResource MonoPrimaryButton}" Margin="0,0,6,0"/>
                        <Button x:Name="BtnBackgroundMode" Content="2º Plano" Style="{StaticResource MonoSecondaryButton}" Margin="0,0,6,0" ToolTip="Minimiza la ventana y continúa ejecutando tareas en segundo plano"/>
                        <Button x:Name="BtnRefreshStatus" Content="Re-auditar" Style="{StaticResource MonoSecondaryButton}" Margin="0,0,6,0"/>
                        <Button x:Name="BtnRollbackAll" Content="Revertir Todo" Style="{StaticResource MonoOutlineDangerButton}"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSessionStatus" Text="Estado: Listo" FontSize="11" Foreground="#9A9A9A" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra de Perfiles y Acciones -->
        <Border Grid.Row="1" Background="#161616" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Perfiles:" FontSize="12" FontWeight="SemiBold" Foreground="#9A9A9A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="BtnProfileLegacy" Content="PC Antiguo" Style="{StaticResource MonoSecondaryButton}" Margin="0,0,5,0"/>
                    <Button x:Name="BtnProfileTrabajo" Content="Oficina" Style="{StaticResource MonoSecondaryButton}" Margin="0,0,5,0"/>
                    <Button x:Name="BtnProfileLaptop" Content="Laptop" Style="{StaticResource MonoSecondaryButton}" Margin="0,0,5,0"/>
                    <Button x:Name="BtnProfileGaming" Content="Gaming" Style="{StaticResource MonoSecondaryButton}" Margin="0,0,5,0"/>
                    <Button x:Name="BtnProfileExtremo" Content="Extremo" Style="{StaticResource MonoSecondaryButton}" Margin="0,0,10,0"/>

                    <TextBox x:Name="TxtSearchBox" Width="165" Height="28" Background="#121212" Foreground="#F2F2F2" BorderBrush="#3A3A3A" BorderThickness="1" Padding="8,4" VerticalContentAlignment="Center" FontSize="12" ToolTip="Buscar ajuste por nombre, ruta o riesgo"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkRestorePoint" Content="Respaldo VSS" IsChecked="True" Foreground="#C8C8C8" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11.5"/>
                    <Button x:Name="BtnSelectAllVisible" Content="Marcar" Style="{StaticResource MonoSecondaryButton}" Margin="0,0,5,0"/>
                    <Button x:Name="BtnClearSelection" Content="Limpiar" Style="{StaticResource MonoSecondaryButton}" Margin="0,0,5,0"/>
                    <Button x:Name="BtnQueueLater" Content="Después" Style="{StaticResource MonoSecondaryButton}" Margin="0,0,6,0" ToolTip="Dejar seleccionados pendientes para ejecutar más tarde o con temporizador en 2º plano"/>
                    <Button x:Name="BtnApplySelected" Content="Aplicar (0)" Style="{StaticResource MonoPrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Área Principal: Categorías + Lista Ligera -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="195"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,10,0">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Top" Text="CATEGORÍAS" FontSize="10.5" FontWeight="Bold" Foreground="#7A7A7A" Margin="6,2,0,8"/>
                    <Button x:Name="NavAll" DockPanel.Dock="Top" Content="Todas" Style="{StaticResource NavCategoryButton}"/>
                    <Button x:Name="NavPerformance" DockPanel.Dock="Top" Content="Rendimiento" Style="{StaticResource NavCategoryButton}"/>
                    <Button x:Name="NavPrivacy" DockPanel.Dock="Top" Content="Privacidad e IA" Style="{StaticResource NavCategoryButton}"/>
                    <Button x:Name="NavNetwork" DockPanel.Dock="Top" Content="Red y DNS" Style="{StaticResource NavCategoryButton}"/>
                    <Button x:Name="NavServices" DockPanel.Dock="Top" Content="Servicios" Style="{StaticResource NavCategoryButton}"/>
                    <Button x:Name="NavDebloat" DockPanel.Dock="Top" Content="Apps (Debloat)" Style="{StaticResource NavCategoryButton}"/>
                    <Button x:Name="NavMaintenance" DockPanel.Dock="Top" Content="Mantenimiento" Style="{StaticResource NavCategoryButton}"/>
                    <Button x:Name="NavStartup" DockPanel.Dock="Top" Content="Apps de Inicio" Style="{StaticResource NavCategoryButton}" Foreground="#F2F2F2"/>

                    <Border DockPanel.Dock="Bottom" Background="#141414" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="Protección Hardware" FontSize="11" FontWeight="Bold" Foreground="#E0E0E0"/>
                            <TextBlock x:Name="TxtGuardrailSummary" Text="Evaluando..." FontSize="10.5" Foreground="#9A9A9A" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PendingQueueBox" DockPanel.Dock="Bottom" Visibility="Collapsed" Background="#202020" BorderBrush="#5A5A5A" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="Pendientes en Cola" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtPendingSummary" Text="0 pendientes" FontSize="10.5" Foreground="#C0C0C0" TextWrapping="Wrap" Margin="0,3,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnRunPendingNow" Content="Ejecutar" Style="{StaticResource MonoPrimaryButton}" Padding="8,4" FontSize="11" Margin="0,0,5,0"/>
                                <Button x:Name="BtnCancelPending" Content="Cancelar" Style="{StaticResource MonoSecondaryButton}" Padding="8,4" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#161616" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <ScrollViewer x:Name="TweakCardsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TweakCardsPanel" Margin="0,0,6,0"/>
                    </ScrollViewer>

                    <ScrollViewer x:Name="StartupAppsScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="StartupAppsPanel" Margin="0,0,6,0"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Zona Detallada de Procesos y Ejecución en Vivo -->
        <Border Grid.Row="3" Background="#141414" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ACTIVIDAD Y PROCESOS" FontSize="11" FontWeight="Bold" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtProgressDetail" Grid.Column="1" Text="En espera" FontSize="12" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="10,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtProcessStats" Grid.Column="2" Text="0/0 • Listo" FontSize="11.5" Foreground="#BDBDBD" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="TxtProcessCurrentStep" Grid.Row="1" Text="Paso actual: Esperando selección del usuario (sin cambios aplicados todavía)." FontSize="11.5" Foreground="#9A9A9A" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>

                <ProgressBar x:Name="MainProgressBar" Grid.Row="2" Height="5" Minimum="0" Maximum="100" Value="0" Background="#242424" Foreground="#EDEDED" BorderThickness="0" Margin="0,0,0,7"/>

                <TextBox x:Name="TxtConsoleLog" Grid.Row="3" Background="#0E0E0E" Foreground="#D4D4D4" BorderBrush="#262626" BorderThickness="1" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="7"/>
            </Grid>
        </Border>
    </Grid>
</Window>
